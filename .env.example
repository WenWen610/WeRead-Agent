# Copy this file to .env.development for local development.
# Never commit real API keys, cookies, JWT secrets, browser state, or production env files.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=development
PROJECT_NAME="WeRead Agent"
VERSION=0.1.0
DESCRIPTION="A local-first AI reading assistant for WeRead notes and Markdown memory"
DEBUG=true
API_V1_STR=/api/v1
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8000"

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Generate a strong value locally, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="change-me"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Used to encrypt/decrypt stored WeRead credentials. Defaults to JWT_SECRET_KEY
# when unset, but a separate secret is better for real deployments.
WEREAD_CREDENTIAL_SECRET=""

# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------
# Supported values: openai, deepseek
LLM_PROVIDER=deepseek
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

DEEPSEEK_API_KEY=""
DEEPSEEK_API_BASE="https://api.deepseek.com/v1"

# For OpenAI try gpt-4o-mini/gpt-5-mini depending on account availability.
# For DeepSeek use deepseek-chat.
DEFAULT_LLM_MODEL=deepseek-chat
DEFAULT_LLM_TEMPERATURE=0.2
REPLY_MAX_TOKENS=2000
REPLY_RESERVE_TOKENS=2000
COMPACT_MAX_TOKENS=4096
COMPACT_RESERVE_TOKENS=4096
MAX_LLM_CALL_RETRIES=3
DEEP_AGENT_RECURSION_LIMIT=9999
DEEP_AGENT_WEB_SEARCH_ENABLED=false

# -----------------------------------------------------------------------------
# Local storage
# -----------------------------------------------------------------------------
# Default: data/local_knowledge
LOCAL_KNOWLEDGE_DIR=data/local_knowledge

# SQLModel app database. Leave DATABASE_URL empty to use SQLite.
DATABASE_URL=
APP_DATABASE_NAME=app.db
# APP_DATABASE_SQLITE_PATH=/absolute/path/to/app.db

# LangGraph checkpoints and Deep Agent store. Defaults live under LOCAL_KNOWLEDGE_DIR.
LANGGRAPH_CHECKPOINT_DB_NAME=langgraph_checkpoints.db
# LANGGRAPH_CHECKPOINT_SQLITE_PATH=/absolute/path/to/langgraph_checkpoints.db
DEEP_AGENT_STORE_DB_NAME=deep_agent_store.db
# DEEP_AGENT_STORE_SQLITE_PATH=/absolute/path/to/deep_agent_store.db

# DATABASE_URL 留空即用 SQLite（默认），无需额外配置。
# 如需 PostgreSQL：先创建数据库，再填 DATABASE_URL=postgresql://user:pass@host:5432/dbname

# -----------------------------------------------------------------------------
# Markdown memory
# -----------------------------------------------------------------------------
MARKDOWN_MEMORY_ENABLED=true
MARKDOWN_MEMORY_ROOT=data/local_knowledge/memory_workspaces
MARKDOWN_MEMORY_INDEX_DB_PATH=data/local_knowledge/markdown_memory_index.db
MARKDOWN_MEMORY_TASK_DB_PATH=data/local_knowledge/markdown_memory_tasks.db
MARKDOWN_MEMORY_AUTO_INTERVAL=5
MARKDOWN_MEMORY_DREAM_CRON="0 3 * * *"
MARKDOWN_MEMORY_DREAM_LOOKBACK_DAYS=14
MARKDOWN_MEMORY_REBUILD_INDEX_ON_START=false

MARKDOWN_MEMORY_SEARCH_MAX_RESULTS=6
MARKDOWN_MEMORY_SEARCH_MIN_SCORE=0.25
MARKDOWN_MEMORY_VECTOR_ENABLED=true
MARKDOWN_MEMORY_FTS_ENABLED=true
MARKDOWN_MEMORY_TEXT_WEIGHT=0.35
MARKDOWN_MEMORY_VECTOR_WEIGHT=0.65
MARKDOWN_MEMORY_MAX_INJECT_CHARS=2500
MARKDOWN_MEMORY_CHUNK_CHARS=1200
MARKDOWN_MEMORY_CHUNK_OVERLAP=120

# Embeddings used by WeRead notes and Markdown memory vector search.
# NOTE_EMBEDDING_ENABLED=false → FTS5 text-only search (no cost, no setup).
# Set to true + choose a provider below to enable semantic search.
#
# Supported providers and examples:
#
# 1. openai
#    NOTE_EMBEDDING_PROVIDER=openai
#    NOTE_EMBEDDING_MODEL=text-embedding-3-small
#    NOTE_EMBEDDING_API_KEY="<your-openai-api-key>"
#    NOTE_EMBEDDING_DIMENSIONS=1536
#
# 2. DeepSeek (via OpenAI-compatible API)
#    NOTE_EMBEDDING_PROVIDER=openai_compatible
#    NOTE_EMBEDDING_MODEL=<deepseek-embedding-model>
#    NOTE_EMBEDDING_API_KEY="<your-deepseek-api-key>"   # 需显式填写，不自动回退 DEEPSEEK_API_KEY
#    NOTE_EMBEDDING_BASE_URL="https://api.deepseek.com/v1"
#
# 3. docker_model_runner (local, free)
#    # docker model run ai/qwen3-embedding:4B --port 12434
#    NOTE_EMBEDDING_PROVIDER=docker_model_runner
#    NOTE_EMBEDDING_MODEL=ai/qwen3-embedding:4B
#    NOTE_EMBEDDING_API_KEY=not-needed
#    NOTE_EMBEDDING_BASE_URL=http://localhost:12434/engines/v1
#    NOTE_EMBEDDING_DIMENSIONS=2560
#
NOTE_EMBEDDING_ENABLED=true
NOTE_EMBEDDING_PROVIDER=docker_model_runner
NOTE_EMBEDDING_MODEL=ai/qwen3-embedding:4B
NOTE_EMBEDDING_API_KEY=not-needed
NOTE_EMBEDDING_BASE_URL=http://localhost:12434/engines/v1
NOTE_EMBEDDING_DIMENSIONS=2560
NOTE_VECTOR_WEIGHT=0.7
NOTE_TEXT_WEIGHT=0.3
NOTE_CANDIDATE_MULTIPLIER=4

# -----------------------------------------------------------------------------
# WeRead
# -----------------------------------------------------------------------------
WEREAD_QR_LOGIN_URL="https://weread.qq.com/"
WEREAD_QR_LOGIN_TIMEOUT_SECONDS=180
WEREAD_QR_POLL_INTERVAL_SECONDS=2
WEREAD_QR_HEADLESS=true
WEREAD_BINDING_AUTO_VALIDATE_AFTER_HOURS=6
WEREAD_BINDING_VALIDATE_NETWORK_BACKOFF_SECONDS=3600
WEREAD_INDEX_DEBOUNCE_MS=3000
WEREAD_INDEX_QUERY_WAIT_MS=500

# -----------------------------------------------------------------------------
# Saved Markdown content
# -----------------------------------------------------------------------------
SAVED_CONTENT_DIR=data/local_knowledge/saved_content

# -----------------------------------------------------------------------------
# Skills
# -----------------------------------------------------------------------------
SKILLS_DIR=skills
SKILLS_STATE_PATH=skills_state.json

# -----------------------------------------------------------------------------
# Optional channels (WeChat / QQ bot, inspired by nanobot)
# -----------------------------------------------------------------------------
# WeChat: register a bot at https://ilinkai.weixin.qq.com → copy token below.
# Then enable in frontend: side panel → WeChat → QR login binding.
# Channel communication pattern adapted from https://github.com/HKUDS/nanobot
WEIXIN_BOT_TOKEN=""
WEIXIN_BASE_URL="https://ilinkai.weixin.qq.com"
WEIXIN_STATE_DIR=""

# QQ channel (not yet fully verified — enable only for testing).
QQ_ENABLED=false
QQ_APP_ID=""
QQ_SECRET=""

# -----------------------------------------------------------------------------
# Rate limits
# -----------------------------------------------------------------------------
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_REGISTER="10 per hour"
RATE_LIMIT_LOGIN="100 per minute"
RATE_LIMIT_ROOT="10 per minute"
RATE_LIMIT_HEALTH="20 per minute"
RATE_LIMIT_WEREAD_VALIDATE="30 per hour"

# -----------------------------------------------------------------------------
# Logging / tracing / evaluation
# -----------------------------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOG_DIR=logs

LANGSMITH_API_KEY=""
LANGSMITH_HOST="https://cloud.langsmith.com"
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT="weread-agent"

EVALUATION_LLM=deepseek-chat
EVALUATION_BASE_URL="https://api.deepseek.com/v1"
EVALUATION_API_KEY=""
EVALUATION_SLEEP_TIME=10
